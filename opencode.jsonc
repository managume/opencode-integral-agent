{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/LEARN.md",
    ".opencode/LEARN.md"
  ],
  "worktree": {
    "directory": "~/.local/share/opencode/worktrees"
  },
  "agents": {
    "plan": {
      "mode": "all",
      "model": "openai/gpt-6-astra#high"
    },
    "build": {
      "mode": "all",
      "model": "openai/gpt-6-luna#high"
    },
    "integral": {
      "mode": "primary",
      "color": "#14b8a6"
    }
  },
  "plugins": [
    "./plugins/integral-model-switch"
  ],
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/var/cache/**",
      "**/var/log/**",
      "**/storage/framework/cache/**",
      "**/storage/framework/views/**",
      "**/storage/framework/sessions/**",
      "**/storage/logs/**"
    ]
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 32768
  },
  "mcp": {
    "ui-skills": {
      "type": "remote",
      "url": "https://www.ui-skills.com/mcp",
      "enabled": true,
      "timeout": 30000
    }
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}
