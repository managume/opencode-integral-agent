# Lista permitida: solo se versionan los archivos Integral enumerados abajo.
# Todo archivo nuevo queda excluido por defecto hasta que se revise y permita.
*
!.gitignore
!README.md
!.npmignore
!package.json
!package-lock.json
!bin/
!bin/integral.js
!lib/
!lib/installer.js
!tests/
!tests/test_continuity_workflow.test.js
!agents/
!agents/integral.md
!commands/
!commands/integral-start.md
!commands/integral-audit.md
!commands/integral-release.md
!commands/integral-doctor.md
!commands/integral-learn-init.js
!commands/integral-modelos-data.js
!plugins/
!plugins/integral-model-switch/
!plugins/integral-model-switch/package.json
!plugins/integral-model-switch/index.js

# Defensa explícita para secretos, datos locales y credenciales accidentales.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*secret*
*credential*
*token*
*api-key*
*apikey*

# Dependencias, cachés, artefactos y archivos locales.
node_modules/
vendor/
dist/
build/
coverage/
.cache/
.tmp/
tmp/
*.log
*.bak
*.backup
*.swp
*.swo
.DS_Store
Thumbs.db
